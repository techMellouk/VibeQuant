# ─────────────────────────────────────────────────────────────────────────────
# @vibequant/sdk environment
#
# Copy to `.env` and fill in. `.env` is gitignored — never commit real secrets.
# These are read by configFromEnv(). SERVER-SIDE ONLY: ALPHA_MNEMONIC and
# ALPHA_ARCADE_API_KEY must never be exposed to the browser.
# ─────────────────────────────────────────────────────────────────────────────

# --- Required ---------------------------------------------------------------

# The Algorand wallet that holds positions and (optionally) signs trades.
ALPHA_WALLET_ADDRESS=

# --- Trading (optional) -----------------------------------------------------
# Provide a mnemonic to enable SERVER-SIDE signing/trading. If omitted, the
# client runs read-only (reads work, trading throws). For client-side signing,
# pass a `signer` in code instead and leave this blank.
ALPHA_MNEMONIC=

# --- Alpha Arcade API (optional but recommended) ----------------------------
# Partner API key. Enables richer market data (images, categories, volume,
# probabilities), reward markets, and wallet-wide order lookups.
# Get one at https://alphaarcade.com -> Account -> Partners -> Create API key.
ALPHA_ARCADE_API_KEY=

# Override the REST API base URL (defaults to the SDK's built-in value).
# ALPHA_API_BASE_URL=https://platform.alphaarcade.com/api

# --- WebSocket (optional) ---------------------------------------------------
# ALPHA_WSS_URL=wss://platform-wss.alphaarcade.com

# --- Algorand network (optional — mainnet defaults shown) -------------------
# ALGOD_SERVER=https://mainnet-api.algonode.cloud
# ALGOD_PORT=443
# ALGOD_TOKEN=
# INDEXER_SERVER=https://mainnet-idx.algonode.cloud
# INDEXER_PORT=443
# INDEXER_TOKEN=

# Mainnet contract / asset ids (only override for testnet or upgrades).
# ALPHA_MATCHER_APP_ID=3078581851
# ALPHA_USDC_ASSET_ID=31566704

# --- Live state engine ------------------------------------------------------
# Poll interval (ms) for account/positions/orders refresh. 0 disables polling.
# VIBEQUANT_POLL_INTERVAL_MS=15000
